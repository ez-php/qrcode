{
  "name": "ez-php/qrcode",
  "version": "2.6.2",
  "description": "Dependency-free QR code encoder (numeric/alphanumeric/byte, versions 1-40, ECC L/M/Q/H) with SVG and PNG (ext-gd) renderers",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Andreas Uretschnig",
      "email": "andreas.uretschnig@gmail.com"
    }
  ],
  "keywords": ["qrcode", "qr", "svg", "png", "php", "ez-php"],
  "homepage": "https://github.com/ez-php/qrcode",
  "support": {
    "issues": "https://github.com/ez-php/qrcode/issues",
    "source": "https://github.com/ez-php/qrcode"
  },
  "require": {
    "php": "^8.5"
  },
  "suggest": {
    "ext-gd": "Needed for Renderer\\PngRenderer"
  },
  "require-dev": {
    "ext-gd": "*",
    "ez-php/docker": "^2.6.0",
    "phpunit/phpunit": "^13.0",
    "phpstan/phpstan": "^2.1",
    "friendsofphp/php-cs-fixer": "^3.94",
    "phpstan/phpstan-strict-rules": "^2.0",
    "phpstan/phpstan-deprecation-rules": "^2.0"
  },
  "autoload": {
    "psr-4": {
      "EzPhp\\QrCode\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "cs": "php-cs-fixer fix",
    "analyse": "phpstan analyse",
    "test": "phpunit",
    "full": "composer analyse && composer cs && composer test"
  }
}
